.{
    .name = .rlimgui_bridge,
    .version = "0.1.0",
    .fingerprint = 0x2bc4f54da53154de,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .rlImGui = .{
            // Pinned to commit SHA (not `refs/heads/main`) so the GitHub
            // auto-generated tarball stays hash-stable. The peer file at
            // labelle-assembler/plugins/imgui/bridges/raylib/build.zig.zon
            // already uses this pin.
            .url = "https://github.com/raylib-extras/rlImGui/archive/286e11acd6c785004c9550c7ed3762add2ae3d47.tar.gz",
            .hash = "N-V-__8AAKW_iQAqIz0VKzpwDjcutAHrY1MFFrQFYuTrihyz",
        },
        .cimgui = .{
            .url = "git+https://github.com/floooh/dcimgui.git#4557d7526fdd977f46ca10c2bbdd63532254f8d6",
            .hash = "cimgui-0.1.0-44ClkXnYlwBKnil7TfCWL9z1Zo_2YJCJREzrpdFiGvA1",
        },
        // Bumped from the stale 5.6.0-dev pin (commit cd71c85) to 6.0.0
        // (commit f25c517) to mirror the assembler's bundled bridge. The
        // 5.6.0-dev build.zig used `std.mem.trimLeft` /
        // `std.process.getEnvVarOwned`, both removed in Zig 0.16, so the
        // raylib+imgui path failed to compile on Zig 0.16 (labelle-imgui#25).
        .@"raylib-zig" = .{
            .url = "https://github.com/raylib-zig/raylib-zig/archive/f25c5173b4c40ef53c7ccf6d8d51ead0892f9f22.tar.gz",
            .hash = "raylib_zig-6.0.0-KE8REDJ4BQBu7lKwYNt6R4j5ywPeS37zqW6zrtjCcRwH",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
